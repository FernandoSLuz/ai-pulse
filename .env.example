# AI Pulse — configuration.
#
# NOTE: In the packaged desktop app you don't need this file — set every key in
# the app's Settings window (they're stored in your user profile, not here).
# This .env is only for running the server directly during development.
# Lookup order (dev only): $AI_PULSE_ENV_FILE > $AI_PULSE_RESOURCE_DIR/.env >
# ./.env > repo root. Launching the desktop app from a source checkout copies
# the keys below into config.json once, on first run (saved keys are never
# overwritten); packaged builds ignore this file entirely.
#
# AI Pulse runs its analyst and chat locally. The first launch downloads the
# selected GGUF and llama-server runtime; no provider key is required.
# The local model catalogue and profiles are maintained by the app.

# Artificial Analysis — optional benchmark enrichment; public rankings need no key.
AA_API_KEY=

# Tavily — optional web search only; it never provides a language model.
TAVILY_API_KEY=

# X/Twitter — optional bearer token for official posts; without it, profiles are links only.
X_API_BEARER_TOKEN=

# Server
PORT=3847
AA_POLL_INTERVAL_MS=7200000
RSS_POLL_INTERVAL_MS=1200000
YT_POLL_INTERVAL_MS=1800000

# Advanced — all optional. The desktop app sets the ones it needs by itself.
# Directory for the SQLite database (default: <userData>/data)
#AI_PULSE_DATA_DIR=
# Packaged server resources (config/, assets/)
#AI_PULSE_RESOURCE_DIR=
# Web dashboard directory served by the server
#AI_PULSE_WEB_DIR=
# Interface to bind. Default 127.0.0.1 (local only); 0.0.0.0 exposes the server to your LAN.
#AI_PULSE_BIND_HOST=127.0.0.1
# Explicit path to a .env file (dev only)
#AI_PULSE_ENV_FILE=
# Set by the desktop app when it spawns the server; reported by GET /api/health
#AI_PULSE_VERSION=
# Linux/Omarchy: colors.toml used to build /theme.css
# (default ~/.local/state/omarchy/current/theme/colors.toml; no file = empty stylesheet)
#OMARCHY_THEME_COLORS=
