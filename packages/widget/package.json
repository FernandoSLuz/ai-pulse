{
  "name": "@ai-pulse/widget",
  "version": "1.0.0-rc.5",
  "productName": "AI Pulse",
  "desktopName": "ai-pulse.desktop",
  "private": true,
  "description": "AI Pulse desktop app — tray, server supervisor, settings, and the leaderboard widget.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/build-resources.mjs",
    "icons": "node scripts/make-icons.mjs",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "dist:ci": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:linux:ci": "npm run build && electron-builder --linux --publish never",
    "dist:linux:dir": "npm run build && electron-builder --linux --dir"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.7",
    "electron-updater": "^6.8.9",
    "node-notifier": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "43.5.1",
    "electron-builder": "^26.15.7",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.2"
  }
}
